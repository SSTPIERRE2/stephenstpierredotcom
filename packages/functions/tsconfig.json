{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["esnext"], // explicitly no "dom"
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/src/*"]
    }
  },
  "include": ["../../types/*", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
